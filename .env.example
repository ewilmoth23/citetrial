# Copy to .env for local development. Never commit real API keys.
CITETRAIL_ENVIRONMENT=development
CITETRAIL_DATA_DIR=~/.local/share/citetrail
CITETRAIL_CORS_ORIGINS=["http://localhost:5173"]
CITETRAIL_ALLOW_HTTP_URLS=false
CITETRAIL_MAX_REDIRECTS=5
CITETRAIL_REQUEST_TIMEOUT_SECONDS=20
CITETRAIL_MAX_DOWNLOAD_BYTES=20971520
CITETRAIL_MAX_UPLOAD_BYTES=52428800
CITETRAIL_MAX_EXTRACTED_CHARS=2000000
CITETRAIL_MAX_PDF_PAGES=1000
CITETRAIL_CHUNK_SIZE=1200
CITETRAIL_CHUNK_OVERLAP=150
CITETRAIL_INGESTION_POLL_SECONDS=0.5
CITETRAIL_SEMANTIC_SEARCH_ENABLED=true
CITETRAIL_EMBEDDING_MODEL=deterministic-feature-hash-v1
CITETRAIL_MODEL_PROVIDER=ollama
CITETRAIL_MODEL_BASE_URL=http://127.0.0.1:11434
CITETRAIL_MODEL_NAME=qwen2.5:7b
CITETRAIL_MODEL_TEMPERATURE=0.1
CITETRAIL_MODEL_MAX_TOKENS=1200
CITETRAIL_MODEL_TIMEOUT_SECONDS=60
CITETRAIL_MODEL_RETRY_COUNT=1
# Only for openai_compatible providers. Do not prefix with VITE_ or expose it to the frontend.
CITETRAIL_MODEL_API_KEY=
VITE_API_URL=/api/v1
